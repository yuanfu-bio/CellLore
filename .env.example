# StepFun is the default OpenAI-compatible provider.
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-3.7-flash
STEPFUN_REASONING_EFFORT=medium
STEPFUN_TIMEOUT_SECONDS=180

# Provider-neutral routing. Supported values: stepfun, openai_compatible,
# openai, openrouter, ollama, anthropic.
SCDATA_AGENT_MODEL_PROVIDER=stepfun

# Generic OpenAI-compatible provider settings.
# SCDATA_AGENT_MODEL_API_KEY=
# SCDATA_AGENT_MODEL_BASE_URL=
# SCDATA_AGENT_MODEL=
# SCDATA_AGENT_REASONING_EFFORT=medium

# Anthropic provider settings.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Observability: local never uploads traces. LangSmith is opt-in.
SCDATA_AGENT_TRACE_MODE=local
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=scdata-agent

# Optional per-role model overrides. Unset values inherit STEPFUN_MODEL or the
# generic provider model. This lets Planner use a higher-capability model.
# SCDATA_AGENT_MODEL_PLANNER=
# SCDATA_AGENT_MODEL_DISCOVERY=
# SCDATA_AGENT_MODEL_REVIEW=
# SCDATA_AGENT_MODEL_CHAT=
# SCDATA_AGENT_REASONING_EFFORT_PLANNER=low
# SCDATA_AGENT_REASONING_EFFORT_DISCOVERY=medium
# SCDATA_AGENT_REASONING_EFFORT_REVIEW=medium

# Sent to NCBI in the aria2 User-Agent for manifest-run downloads. Optional:
# unset just means a less identifiable User-Agent, never a hard failure.
NCBI_CONTACT_EMAIL=

# Path to the aria2c binary, if it is not simply "aria2c" on PATH.
# SCDATA_AGENT_ARIA2_BIN=
