# Local credentials and runtime settings.
# Copy this file to .env, then configure ONE model provider.
# Never commit the populated .env file.

# -----------------------------------------------------------------------------
# StepFun (enabled by default)
# -----------------------------------------------------------------------------
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-3.7-flash
STEPFUN_REASONING_EFFORT=high
STEPFUN_TIMEOUT_SECONDS=180

# -----------------------------------------------------------------------------
# DeepSeek (disabled by default)
# -----------------------------------------------------------------------------
# To switch from StepFun to DeepSeek:
#   1. Comment out all STEPFUN_* lines above.
#   2. Remove the leading # from all DEEPSEEK_* lines below and add your key.
#   3. In the provider section, comment out "stepfun" and uncomment "deepseek".
#
# Model choice:
#   deepseek-v4-flash = faster and more economical (recommended default)
#   deepseek-v4-pro   = stronger but slower
#
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# SCDATA_AGENT_LLM_HTTP_TIMEOUT_SECONDS=240

# Keep exactly ONE provider line enabled.
SCDATA_AGENT_MODEL_PROVIDER=stepfun
# SCDATA_AGENT_MODEL_PROVIDER=deepseek

# LangSmith cloud tracing (optional; research questions and run traces are uploaded)
# Set both values below only when you deliberately want cloud tracing.
SCDATA_AGENT_TRACE_MODE=local
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=celllore

# LangGraph Studio local checkpoint database (no API key required)
SCDATA_AGENT_STUDIO_DATABASE=var/studio_celllore.sqlite

# Recommended for sustained NCBI GEO/SRA use (optional)
# NCBI_EMAIL=
# NCBI_API_KEY=
